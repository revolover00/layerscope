{
  "name": "layerscope",
  "version": "0.2.0",
  "description": "Docker image inspector -- browser UI and CLI. Local-only analysis: no backend, no uploads.",
  "type": "module",
  "bin": {
    "layerscope": "./bin/layerscope.mjs"
  },
  "scripts": {
    "test": "node --test",
    "synth": "node tools/synth.mjs --all",
    "analyze": "node tools/analyze.mjs",
    "compare": "node tools/compare.mjs",
    "verify": "node tools/verify-fixtures.mjs",
    "smoke": "node tools/smoke-ui.mjs",
    "bench:memory": "node --expose-gc tools/bench-memory.mjs",
    "browser:bench": "node tools/browser-bench.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "playwright-core": "^1.48.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revolover00/layerscope.git"
  },
  "homepage": "https://github.com/revolover00/layerscope",
  "bugs": "https://github.com/revolover00/layerscope/issues",
  "keywords": [
    "docker",
    "image",
    "container",
    "layers",
    "dive",
    "dockerfile",
    "bloat",
    "cli"
  ],
  "files": [
    "bin",
    "src/cli",
    "src/core",
    "assets/vendor/fzstd",
    "NOTICE"
  ]
}
